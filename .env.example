# 인프라성 값 (배포 환경마다 달라질 수 있는 값). cp .env.example .env
# 제스처 튜닝값은 .env.tuning.example 참고 (cp .env.tuning.example .env.tuning)

# ---- 공통 ----
DEFAULT_SESSION_ID=poc-001
# 로깅: debug/info/warning/error 중 하나 (Node는 pino 표기 그대로 debug/info/warn/error 사용)
LOG_LEVEL=info
# 로깅: 알림 정책(docs/04-alert-policy.md) 구현체가 쓰는 값. SLACK_WEBHOOK_URL이 비어있으면
# 3개 서비스 모두 알림 로직이 완전히 비활성 상태 — 실제 채널이 정해지면 여기에 웹훅 URL만 채우면 됨.
SLACK_WEBHOOK_URL=
# ERROR 반복 발생 임계치. 기본값은 안전한 초기값일 뿐 실사용 트래픽 보고 조정 권장.
ALERT_ERROR_WINDOW_MS=300000
ALERT_ERROR_THRESHOLD=10

# ---- Web_Server (Container A) ----
PORT=8000
CONTAINER_B_URL=ws://video_engine:8001/ws
MOTION_ENGINE_URL=http://motion_engine:8002/gesture
DEFAULT_HOST=192.168.55.208
RECONNECT_DELAY_MS=5000
MOTION_ENGINE_TIMEOUT_MS=2000
JSON_BODY_LIMIT=10mb
# 예외처리: Motion_Engine 서킷브레이커 / idle 세션 정리 / 프레임 통계 로그 주기
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=10000
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_SWEEP_INTERVAL_MS=300000
FRAME_STATS_LOG_INTERVAL_MS=30000

# ---- Video_Engine (Container B) ----
# 버그수정: MOTION_ENGINE_WS_URL은 Video_Engine 프로덕션 코드가 더 이상 읽지 않음(중복 연산 버그로 제거).
# webcam_motion_test.py(독립 테스트 스크립트)를 로컬에서 돌릴 때만 필요하며, 그 스크립트는
# 이 값을 못 찾으면 자체 기본값(ws://localhost:8002/ws)을 사용하므로 여기 없어도 문제 없음.
HAND_LANDMARKER_MODEL_PATH=
HAND_NUM_HANDS=1
HAND_MIN_DETECTION_CONFIDENCE=0.6
HAND_MIN_PRESENCE_CONFIDENCE=0.5
HAND_MIN_TRACKING_CONFIDENCE=0.5
# 로깅: 이 시간(초) 넘게 연속으로 손이 안 잡히면 WARNING으로 1회 격상 (docs/01-log-level-guidelines.md)
NO_HAND_WARNING_SECONDS=3.0
