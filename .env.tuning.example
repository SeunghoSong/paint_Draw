# 제스처 인식 튜닝값 (Motion_Engine 전용, 배포 환경과 무관한 알고리즘 상수).
# cp .env.tuning.example .env.tuning

SESSION_EXPIRY_SECONDS=600
ACTION_QUEUE_MAXLEN=3
ACTION_STABLE_MIN_COUNT=2
GESTURE_THUMB_PALM_OPEN_THRESHOLD=0.15
GESTURE_THUMB_INDEX_BASE_OPEN_THRESHOLD=0.12
GESTURE_THUMB_FOLDED_THRESHOLD=0.13
GESTURE_ERASE_HEIGHT_DIFF_THRESHOLD=0.12
GESTURE_ZOOM_DELTA=0.008
EMA_MICRO_MOVE_THRESHOLD=0.001
EMA_ALPHA_MICRO=0.35
EMA_PRECISE_MOVE_THRESHOLD=0.05
EMA_ALPHA_PRECISE=0.50
EMA_ALPHA_FAST=0.85
